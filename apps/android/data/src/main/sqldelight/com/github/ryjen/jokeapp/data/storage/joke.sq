import kotlin.Boolean;
import java.util.Date;

CREATE TABLE joke (
  id INTEGER PRIMARY KEY,
  key TEXT NOT NULL,
  content TEXT NOT NULL,
  created TEXT AS Date DEFAULT CURRENT_TIME,
  isFavorite INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX joke_key ON joke(key);

random:
SELECT * FROM joke ORDER BY RANDOM() LIMIT 1;

get:
SELECT * FROM joke WHERE key = :key LIMIT 1;

list:
SELECT * FROM joke ORDER BY created;

favorites:
SELECT * FROM joke WHERE isFavorite = 1 ORDER BY created;

updateFavorite:
UPDATE joke SET isFavorite = :isFavorite WHERE id = (SELECT id FROM joke WHERE key = :key LIMIT 1);

insert:
INSERT INTO joke(key, content, created, isFavorite) VALUES(?, ?, ?, ?);

insertOrIgnore:
INSERT OR IGNORE INTO joke(key, content, created, isFavorite) VALUES(?, ?, ?, ?);

delete:
DELETE FROM joke WHERE id = (SELECT id FROM joke WHERE key = :key LIMIT 1);

